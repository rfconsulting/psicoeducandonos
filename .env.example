NODE_ENV=development
PORT=3000
TRUST_PROXY=0
SESSION_SECRET=REEMPLAZAR_CON_64_CARACTERES_ALEATORIOS_ANTES_DE_INICIAR_1234567890

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=psicoeducandonos
DB_USER=psico_app
DB_PASSWORD=una-clave-de-base-de-datos-segura
DB_CONNECTION_LIMIT=10

# Servicio HTTPS que recibe { email, resetUrl } y envía correos de recuperación o activación.
# Déjalo vacío en desarrollo si aún no configuraste un proveedor.
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:3000

# 64 caracteres hexadecimales. Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_WEBHOOK_SECRET=
DATA_RETENTION_DAYS=730

# Solo se usan al ejecutar: npm run create-superuser
SUPERUSER_NAME=Superusuario
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=Reemplazar-por-una-clave-muy-segura
